ANTHROPIC_API_KEY=

# Frontend target. Leave blank to auto-detect the machine's LAN IP (port 3000),
# so the app is reached as a real network client would — never localhost.
# Set an explicit URL only to override the detected host/port.
TJ_FRONTEND_URL=

# Backend target (Laravel's default serve port). Leave blank to auto-detect the
# same LAN IP (port 9000).
TJ_BACKEND_URL=

# A low-privilege account the agents sign in as, so privilege-escalation attempts
# start from a normal user's position. Leave blank to skip authenticated flows.
TJ_USER_EMAIL=
TJ_USER_PASSWORD=

# Hosts the agents are ALLOWED to touch. Any request to a host not in this list is
# refused before it leaves the browser — this is the authorization boundary. Leave
# blank to scope to the (auto-detected) frontend and backend hosts only.
TJ_SCOPE_HOSTS=

# Run with a visible browser window (true) or headless (false).
TJ_HEADFUL=true
